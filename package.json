{
  "name": "gridiron-director",
  "productName": "Gridiron Director",
  "version": "0.21.1",
  "private": true,
  "description": "A football management and coaching game with independent careers and a 3D match engine.",
  "main": "desktop/main.cjs",
  "author": "Gridiron Director",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/test-all.mjs",
    "package:mac:arm64": "node scripts/package-desktop.mjs darwin arm64",
    "package:mac:x64": "node scripts/package-desktop.mjs darwin x64",
    "package:linux": "node scripts/package-desktop.mjs linux x64",
    "package:windows": "node scripts/package-desktop.mjs win32 x64",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "source:archive": "node scripts/source-archive.mjs",
    "check:mac": "node scripts/check-mac-launch.mjs",
    "ue:replay": "node scripts/ue-replay.mjs",
    "ue:setup": "powershell -ExecutionPolicy Bypass -File unreal/Tools/setup.ps1",
    "ue:package": "powershell -ExecutionPolicy Bypass -File unreal/Tools/package.ps1",
    "ue:check-stream": "electron scripts/check-ue-stream.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "fake-indexeddb": "6.2.4"
  },
  "build": {
    "appId": "game.gridirondirector.desktop",
    "productName": "Gridiron Director",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!dist/downloads/**"
    ],
    "mac": {
      "category": "public.app-category.sports-games",
      "icon": "desktop/icon.icns",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist"
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  },
  "type": "module"
}
